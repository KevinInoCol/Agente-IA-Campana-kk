# ============================================
# Agente WhatsApp · Toto Reyes — variables de entorno
# ============================================
# Copiar a .env y completar. NUNCA subir el .env.

# --- LLM / transcripción ---
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1

# --- SmartGob Conecta (canal WhatsApp) ---
SMARTGOB_API_URL=https://smartconecta.origamismartgob.com/api/v1
SMARTGOB_API_KEY=             # credencial de integración sgc_… (Datos/key-conexion.txt)
SMARTGOB_CONNECTION_ID=       # id de la conexión "TOTO REYES" (GET /connections)
SMARTGOB_WEBHOOK_SECRET=      # secreto de firma del webhook (se muestra una sola vez en el panel)

# --- Postgres (memoria del agente + tabla de simpatizantes) ---
# DATABASE_URL tiene prioridad; si no, se arma con DB_*.
DATABASE_URL=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_SCHEMA=campana_toto_reyes
DB_POOL_MAX=10

# --- Google Apps Script (opcional: planilla del equipo) ---
APPS_SCRIPT_WEBHOOK_URL=

# --- Registro civil (DINARDAP vía ventanilla municipal; la misma fuente que MAD) ---
# ninguna = no consulta (solo valida el módulo 10) | stub = cédulas sintéticas | ventanilla = real
PERSONA_FUENTE=ninguna
VENTANILLA_DINARDAP_USER=
VENTANILLA_DINARDAP_PASSWORD=
#VENTANILLA_DINARDAP_URL=https://ventanilla.rmpplayas.gob.ec/services/api/dinardap/consulta
#PERSONA_TIMEOUT_MS=8000

# --- Redis (debounce de mensajes) ---
REDIS_URL=
DEBOUNCE_ENABLED=true
DEBOUNCE_WINDOW_SECONDS=15
DEBOUNCE_TTL_SECONDS=300
DEBOUNCE_SEPARATOR=\n

# --- Guardrail de entrada local (6 capas, sin red) ---
GUARDRAIL_PII_ENABLED=false

# --- Model Armor (Google Cloud) — APAGADO hasta tener la cuenta de GCP ---
# Ver guardrails_model_armor/README.md.
MODEL_ARMOR_PROJECT_ID=
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=
MODEL_ARMOR_CREDENTIALS_JSON=   # contenido del JSON de la cuenta de servicio (rol modelarmor.user)
MODEL_ARMOR_FAIL_CLOSED=false

# --- Langfuse (observabilidad; opcional) ---
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# --- Qdrant (RAG; todavía sin uso en el agente) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=tenant_id_campana_toto_reyes
EMBEDDING_MODEL=text-embedding-3-large
RETRIEVAL_TOP_K=4

# Solo desarrollo: aceptar webhooks sin firma. NUNCA en producción.
SMARTGOB_ALLOW_UNSIGNED=false
